# Copy to .env.local and fill in once you've created a Supabase project.
# The app runs on mock data (src/lib/mock-data.ts) until these are set.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — never prefix with NEXT_PUBLIC_, never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# Payment gateway (stubbed — see src/lib/payment.ts). Fill in once a provider
# (Payme, Click, etc.) is chosen.
PAYMENT_PROVIDER_API_KEY=

# Comma-separated list of emails allowed to log into /admin. The account
# itself is created in Supabase Auth (Dashboard -> Authentication -> Add
# user) — this only controls who, once logged in, is treated as an admin.
ADMIN_EMAILS=admin@nihol.uz
